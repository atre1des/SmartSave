# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing / keystore files (sensitive - never commit)
*.jks
*.keystore
*.key
android/key.properties
android/app/key.properties
**/key.properties

# iOS signing
*.p12
*.mobileprovision
ios/*.p12
ios/*.mobileprovision

# Environment secrets (API keys must never be committed)
.env
.env.*
.env.local
.env.production
backend/.env
backend/.env.*
backend/.env.local
backend/.env.production

# Firebase service account credentials (PRIVATE - never commit)
**/service-account*.json
**/firebase-adminsdk*.json
**/*-service-account*.json
backend/*-service-account*.json
functions/*-service-account*.json

# Firebase client configuration (PUBLIC - OK to commit for Flutter app)
# google-services.json (Android) and GoogleService-Info.plist (iOS) are
# public config files required by the app at build time.
# They do NOT contain private keys and are safe to commit.
# DO NOT add them to .gitignore

# Generated builds and artifacts
*.apk
*.aab
*.ipa
*.app
*.dSYM
build/
**/build/

# Local databases containing personal/sensitive information
*.db
*.sqlite
*.sqlite3
smartsave_*.db
smartsave_*.sqlite
*.db-journal
*.db-shm
*.db-wal

# IDE temporary files
.idea/
.vscode/
*.swp
*.swo
*~

# Sensitive logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
flutter_*.log

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# Backup and temporary files
*.bak
*.tmp
*.temp
*.orig
*.rej

# Coverage reports (generated)
coverage/
*.lcov

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/**/*.json

# Flutter specific
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/

# Node.js dependencies
node_modules/
backend/node_modules/

# Misc
*.pid
*.seed
*.pid.lock
"smartsave_v5.zip" 

# Flutter localizations generated from the checked-in ARB catalogs
/lib/l10n/generated/
